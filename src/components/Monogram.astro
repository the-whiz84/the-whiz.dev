---
interface Props {
  size?: number;
}

const { size = 22 } = Astro.props;
const width = Math.round((size * 36) / 28);
---

<svg
  width={width}
  height={size}
  viewBox="0 0 36 28"
  fill="none"
  aria-hidden="true"
  class="shrink-0"
>
  <rect x="2" y="5" width="15" height="3.2" fill="currentColor" />
  <rect x="7.9" y="8" width="3.2" height="15" fill="currentColor" />
  <polygon points="15.2,5 18.4,5 21.6,23 18.4,23" fill="currentColor" />
  <polygon points="18.4,23 21.6,23 25.4,11.5 22.4,11.5" fill="currentColor" />
  <polygon points="22.4,11.5 25.4,11.5 29.4,23 26.2,23" fill="currentColor" />
  <polygon points="26.2,23 29.4,23 34.2,5 31,5" fill="var(--signal)" />
</svg>
