---
import { profile, socials } from '../data/site';

const buildYear = new Date().getFullYear();
---

<footer
  class="w-full border-t border-[var(--rule)] bg-[var(--paper-alt)] font-mono text-[13px] text-[var(--ink-muted)]"
>
  <div
    class="mx-auto flex w-full max-w-[1360px] flex-wrap items-center justify-between gap-4 px-5 py-5 sm:px-8 lg:px-12"
  >
    <span>
      © <span data-current-year>{buildYear}</span> {profile.name} · {profile.handle}
    </span>

    <div class="inline-flex flex-wrap items-center gap-5">
      {
        socials.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="border-b border-[var(--rule)] text-[var(--ink)] no-underline transition-colors hover:border-[var(--signal)] hover:text-[var(--signal)]"
          >
            {item.name}
          </a>
        ))
      }
      <a
        href="/privacy"
        class="border-b border-[var(--rule)] text-[var(--ink)] no-underline transition-colors hover:border-[var(--signal)] hover:text-[var(--signal)]"
      >
        Privacy
      </a>
    </div>
  </div>
</footer>
